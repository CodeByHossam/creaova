# Copy to `.env` for local production builds: Copy-Item .env.example .env
# Never commit `.env`. Every VITE_* value is embedded in the public browser
# bundle, so do not put server secrets here.

# Canonical origin. Must be https, must not be a reserved example.com host, and
# must not include a path or query string. Use the onrender.com host only as a
# temporary preview; a custom domain is required before public launch.
VITE_SITE_URL=https://creaova.example.com

# The contact form is currently implemented for Web3Forms.
VITE_FORM_PROVIDER=web3forms
VITE_FORM_ENDPOINT=https://api.web3forms.com/submit

# Public Web3Forms access key for the destination inbox. Get it from the
# Web3Forms dashboard. Rotate it immediately if it ever appears in Git history
# or a support ticket.
VITE_FORM_ACCESS_KEY=00000000-0000-0000-0000-000000000000

# Optional hCaptcha site key. The value below is Web3Forms' public free-plan
# site key. Replace it only if you use a paid/custom hCaptcha key.
VITE_FORM_CAPTCHA_SITEKEY=50b2fe65-b00b-4b9e-ad62-3ba471098be2
