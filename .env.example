# ---------------------------------------------------------------------------
# Creaova — environment configuration
# Reference: doc/MULTIPAGE_UI_PLAN.md §4.1
#
# Copy this file to `.env` and fill it in.
#
# ⚠️  Only `VITE_`-prefixed variables reach the client bundle, and everything in
#     that bundle is public. NEVER put a secret in this file. The Web3Forms
#     access key is public by design — it is scoped to one destination inbox.
#
# ⚠️  The values below are reserved demo placeholders (RFC 2606). Replacing them
#     before launch is a release blocker — see §16 of the plan.
# ---------------------------------------------------------------------------

# Canonical site origin. No trailing slash.
# Used for canonical URLs, Open Graph tags and sitemap.xml.
# `.example.com` is reserved and can never resolve.
VITE_SITE_URL=https://creaova.example.com

# Contact form provider. Locked to Web3Forms (§0 D6).
VITE_FORM_PROVIDER=web3forms

# Web3Forms endpoint, including your access key, e.g.
#   https://api.web3forms.com/submit?access_key=xxxxxxxx-xxxx-xxxx
# Create a key at https://web3forms.com — leave empty until milestone M6.
VITE_FORM_ENDPOINT=
